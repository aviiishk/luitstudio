NEXT_PUBLIC_SITE_URL=https://luit.studio
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_BEHANCE_URL=

# Cal.com booking link (username/event-type). Defaults to the studio's
# intro-call event if unset.
NEXT_PUBLIC_CAL_LINK=luit-studio-xv0sbd/intro-call

# WhatsApp number in international format, no "+" or spaces (used to build
# wa.me links). Defaults to the studio's number if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=917634885371

# CallMeBot (callmebot.com) — sends a WhatsApp message to each recipient
# whenever the contact form is submitted. Each person opts in once by
# messaging the bot from their own WhatsApp and gets back their own API
# key; see callmebot.com/blog/free-api-whatsapp-messages for the steps.
# Server-only (no NEXT_PUBLIC_ prefix) — leave unset to skip notifications.
CALLMEBOT_ABHISHEK_PHONE=
CALLMEBOT_ABHISHEK_API_KEY=
CALLMEBOT_PRINCE_PHONE=
CALLMEBOT_PRINCE_API_KEY=

# Resend (resend.com) — emails the addresses below whenever the contact
# form is submitted. Needs a Resend account, a verified sending domain
# (e.g. luit.studio) so RESEND_FROM_EMAIL can use it, and an API key.
# Leave unset to skip email notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAILS=

# Shared secret verifying that requests to /api/cal-webhook really come
# from Cal.com (checked against the x-cal-signature-256 header). Paste
# the same value into the webhook's "Secret" field in Cal.com's dashboard
# (Settings > Developer > Webhooks). Any random string works.
CAL_WEBHOOK_SECRET=

# Google Analytics 4 measurement ID (analytics.google.com). Leave unset
# to skip loading analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase project backing the blog + admin dashboard (shared with luitstudio).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Supabase dashboard -> Settings -> API -> Project API
# keys -> service_role). Bypasses RLS entirely -- server-only, never used
# by the Next.js app itself. Only used by scripts/team-positions.mjs, a
# local maintenance CLI for reading/writing team_members.canvas_x/canvas_y
# directly without needing a logged-in admin session. Keep this out of
# any client bundle; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (general-purpose image uploads, not just blog). Cloud name and
# upload preset are safe to expose publicly (used for unsigned browser
# uploads). CLOUDINARY_API_SECRET is sensitive — server-only, currently
# unused by any code path, kept for future signed operations.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_SECRET=
